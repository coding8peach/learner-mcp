# Login that can only use the "learner" tables (see scripts/app_role_sql.py)
DATABASE_URL=postgresql://learner_mcp_app.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# HTTP mode only. One key per app, name:key, comma-separated.
# Make keys with: uv run python scripts/new_api_key.py <app-name>
LEARNER_MCP_API_KEYS=sidekick:replace-with-a-generated-key

# Secret for email fingerprints (emails themselves are never stored).
# 24+ random characters; don't change it later or saved emails stop matching.
LEARNER_EMAIL_KEY=
